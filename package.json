{
  "name": "all-in-one-fitness",
  "version": "0.3.0",
  "private": true,
  "description": "All-in-One Fitness & AI Biomechanical Coach - Android APK (React Native + Expo Dev Build)",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "eas:build:dev": "eas build --profile development --platform android",
    "eas:build:apk": "eas build --profile preview --platform android",
    "eas:build:prod": "eas build --profile production --platform android",
    "supabase:migrate": "supabase db push",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.3.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.9.26",
    "@scottjgilroy/react-native-vision-camera-v4-pose-detection": "^1.2.2",
    "@shopify/react-native-skia": "1.2.3",
    "@supabase/supabase-js": "^2.45.4",
    "expo": "~51.0.28",
    "expo-application": "5.9.1",
    "expo-asset": "10.0.6",
    "expo-build-properties": "~0.12.5",
    "expo-file-system": "17.0.1",
    "expo-keep-awake": "~13.0.2",
    "expo-secure-store": "~13.0.2",
    "expo-sharing": "~12.0.1",
    "expo-sqlite": "14.0.6",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-health-connect": "3.2.0",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-vision-camera": "^4.5.2",
    "react-native-worklets-core": "^0.4.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.79",
    "supabase": "^2.0.0",
    "typescript": "~5.3.3"
  },
  "expo": {
    "autolinking": {
      "exclude": []
    }
  }
}
